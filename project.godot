; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Friedenheim"
config/name_localized={
"ja": "フリーデンハイム"
}
config/version="0.0.0-dev.2"
run/main_scene="res://src/shared/views/title_screen.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="uid://crwya6wcrr5li"

[audio]

buses/default_bus_layout="uid://c01x3prldpupy"

[autoload]

ConfigManager="*uid://dn5hq8dah2i8i"
GameManager="*uid://qf8nfoh2krbi"

[display]

window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/yard/plugin.cfg")

[importer_defaults]

texture={
&"detect_3d/compress_to": 0
}

[internationalization]

locale/translations=PackedStringArray("res://src/data/localization/en.po", "res://src/data/localization/ja.po")
locale/translations_pot_files=PackedStringArray("res://src/shared/views/title_screen.tscn", "res://src/shared/views/settings_overlay.tscn")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
